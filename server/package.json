{
  "name": "wire-node-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "npm run db:upgrade && prisma db push --skip-generate && tsx src/index.ts",
    "db:upgrade": "prisma db execute --file prisma/upgrade.sql --schema prisma/schema.prisma",
    "db:push": "npm run db:upgrade && prisma db push",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.1",
    "@fastify/static": "^8.0.2",
    "@prisma/client": "^6.1.0",
    "archiver": "^7.0.1",
    "fastify": "^5.1.0",
    "prisma": "^6.1.0",
    "sharp": "^0.33.5",
    "tar": "^7.4.3",
    "tsx": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
