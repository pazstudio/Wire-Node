generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A machine project. PCBs are placed in projects; connections and zones belong to one project.
model Project {
  id           String          @id @default(uuid())
  name         String
  machine      String          @default("")
  description  String          @default("")
  /// Set when the project is locked (e.g. the device shipped). A locked project cannot be changed
  /// and uses its own frozen copies of library components, connector types and cables.
  lockedAt     DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  pcbs         ProjectPcb[]
  folders      Folder[]
  connections  Connection[]
  zones        Zone[]
  frozenPcbs   Pcb[]
  frozenTypes  ConnectorType[]
  frozenCables Cable[]
}

/// Folder on a project tab: groups placed components (e.g. "Toolhead") or connections.
/// Stored in the "ComponentFolder" table, its name from when only components had folders.
model Folder {
  id          String       @id @default(uuid())
  projectId   String
  /// "components" or "connections": the tab the folder is on.
  kind        String       @default("components")
  name        String
  createdAt   DateTime     @default(now())
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pcbs        ProjectPcb[]
  connections Connection[]

  @@index([projectId])
  @@map("ComponentFolder")
}

/// Library PCB (shared between projects). Image is stored on the uploads volume.
model Pcb {
  id                String         @id @default(uuid())
  name              String
  description       String         @default("")
  imagePath         String
  thumbPath         String
  imageWidth        Int
  imageHeight       Int
  /// Set on a frozen copy kept by a locked project; null = in the library.
  frozenInProjectId String?
  /// Library item the frozen copy was made from (may have been deleted since).
  sourceId          String?
  createdAt         DateTime       @default(now())
  frozenIn          Project?       @relation(fields: [frozenInProjectId], references: [id], onDelete: Cascade)
  projects          ProjectPcb[]
  connectors        PcbConnector[]

  @@index([frozenInProjectId])
}

/// A library component placed in a project. The same component can be placed several times
/// (e.g. "Peltier Driver - Toolhead1" and "Peltier Driver - Toolhead2"); each placement has
/// its own name and block position on the project map.
model ProjectPcb {
  /// Generated by the database so `prisma db push` can add it to existing rows.
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String
  pcbId     String
  /// Name in this project. Empty means "use the component name".
  name      String           @default("")
  mapX      Float            @default(0)
  mapY      Float            @default(0)
  /// Folder on the Components tab; null = not in a folder. Deleting a folder keeps its components.
  folderId  String?
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pcb       Pcb              @relation(fields: [pcbId], references: [id], onDelete: Cascade)
  folder    Folder?          @relation(fields: [folderId], references: [id], onDelete: SetNull)
  nodes     ConnectionNode[]

  @@index([projectId])
}

/// Library connector part (e.g. "JST-XH 4P").
model ConnectorType {
  id                String           @id @default(uuid())
  name              String
  pinCount          Int
  rowCount          Int              @default(1)
  crimpName         String           @default("")
  imagePath         String?
  thumbPath         String?
  /// Set on a frozen copy kept by a locked project; null = in the library.
  frozenInProjectId String?
  /// Library item the frozen copy was made from (may have been deleted since).
  sourceId          String?
  createdAt         DateTime         @default(now())
  frozenIn          Project?         @relation(fields: [frozenInProjectId], references: [id], onDelete: Cascade)
  instances         PcbConnector[]
  nodes             ConnectionNode[]
}

/// A connector drawn as a rectangle on a PCB photo.
/// x/y/w/h are normalized (0..1) relative to the image size, so they render
/// at the same spot on any screen size.
/// pins: [{ n: number, name: string, color: string }]
model PcbConnector {
  id              String           @id @default(uuid())
  pcbId           String
  connectorTypeId String?
  label           String           @default("")
  /// What the connector is for on this board, e.g. "Power", "Temperature sensor".
  name            String           @default("")
  x               Float
  y               Float
  w               Float
  h               Float
  rotation        Float            @default(0)
  pins            Json             @default("[]")
  /// On a frozen copy: the library connector it was copied from.
  sourceId        String?
  updatedAt       DateTime         @updatedAt
  pcb             Pcb              @relation(fields: [pcbId], references: [id], onDelete: Cascade)
  connectorType   ConnectorType?   @relation(fields: [connectorTypeId], references: [id], onDelete: SetNull)
  nodes           ConnectionNode[]
}

/// Library cable. cores: [{ color: string }]
model Cable {
  id                String   @id @default(uuid())
  name              String
  description       String   @default("")
  coreCount         Int
  cores             Json     @default("[]")
  shielded          Boolean  @default(false)
  gauge             String   @default("")
  lengthMm          Float?
  /// Set on a frozen copy kept by a locked project; null = in the library.
  frozenInProjectId String?
  /// Library item the frozen copy was made from (may have been deleted since).
  sourceId          String?
  createdAt         DateTime @default(now())
  frozenIn          Project? @relation(fields: [frozenInProjectId], references: [id], onDelete: Cascade)
  wires             Wire[]
}

/// A connection (direct or harness) inside a project: a graph of connector nodes and pin-to-pin wires.
model Connection {
  id           String           @id @default(uuid())
  projectId    String
  name         String
  description  String           @default("")
  kind         String           @default("direct")
  /// Cable length of the whole connection in mm. Wires can override it (harness branches).
  lengthMm     Float?
  /// Components (ProjectPcb ids) chosen for this connection; the editor lists only their connectors.
  /// Placements that already have connectors in the diagram count as chosen even if missing here.
  placementIds String[]         @default([])
  /// Zones drawn in the diagram to group connectors by machine part (e.g. "Frame", "Toolhead").
  /// [{ id, name, color, x, y, w, h }]
  zones        Json             @default("[]")
  /// Folder on the Connections tab; null = not in a folder.
  folderId     String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder       Folder?          @relation(fields: [folderId], references: [id], onDelete: SetNull)
  nodes        ConnectionNode[]
  wires        Wire[]
}

/// A connector placed in a connection diagram. Either references a connector drawn
/// on a PCB (plus which placement of that PCB in the project), or is a "free" connector
/// (inline harness connector / splice).
model ConnectionNode {
  id              String         @id @default(uuid())
  connectionId    String
  pcbConnectorId  String?
  projectPcbId    String?        @db.Uuid
  connectorTypeId String?
  label           String         @default("")
  pinCount        Int            @default(0)
  x               Float          @default(0)
  y               Float          @default(0)
  connection      Connection     @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  pcbConnector    PcbConnector?  @relation(fields: [pcbConnectorId], references: [id], onDelete: Cascade)
  projectPcb      ProjectPcb?    @relation(fields: [projectPcbId], references: [id], onDelete: Cascade)
  connectorType   ConnectorType? @relation(fields: [connectorTypeId], references: [id], onDelete: SetNull)
  wiresFrom       Wire[]         @relation("WireFrom")
  wiresTo         Wire[]         @relation("WireTo")
}

/// One wire from a pin to a pin. Optionally a core of a library cable.
model Wire {
  id           String         @id @default(uuid())
  connectionId String
  fromNodeId   String
  fromPin      Int
  toNodeId     String
  toPin        Int
  cableId      String?
  coreIndex    Int?
  color        String         @default("")
  /// Length of this wire in mm; null means "same as the connection length".
  lengthMm     Float?
  note         String         @default("")
  connection   Connection     @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  fromNode     ConnectionNode @relation("WireFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode       ConnectionNode @relation("WireTo", fields: [toNodeId], references: [id], onDelete: Cascade)
  cable        Cable?         @relation(fields: [cableId], references: [id], onDelete: SetNull)
}

/// Semi-transparent zone rectangle on the project map (e.g. "Frame", "Toolhead").
model Zone {
  id        String  @id @default(uuid())
  projectId String
  name      String  @default("Zone")
  color     String  @default("#3b82f6")
  x         Float
  y         Float
  w         Float
  h         Float
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
